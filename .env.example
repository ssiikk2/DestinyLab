SITE_NAME=Love Compatibility Calculator
SITE_TAGLINE=Compatibility guides, calculators, and zodiac insights for reflection and entertainment purposes.
SITE_DOMAIN=https://lovecompatibilitycalculator.com

# Keep ads disabled locally and in staging. Turn on only after layout and policy checks.
ADS_ENABLED=false
ADSENSE_CLIENT=ca-pub-9161450133304636

# Optional analytics.
NEXT_PUBLIC_GA_ID=

# Azure OpenAI is used by the meme/spicy upgrade endpoints and generation checks.
AI_PROVIDER=azure-openai
AZURE_OPENAI_PRIMARY_ENDPOINT=https://<primary-resource>.openai.azure.com
AZURE_OPENAI_SECONDARY_ENDPOINT=https://<secondary-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_DEPLOYMENT_NAME=<mini-deployment>
AZURE_OPENAI_NANO_DEPLOYMENT_NAME=<nano-deployment>
AZURE_OPENAI_API_VERSION=2024-10-21
USE_NANO=false

# Optional IndexNow key for Bing indexing pings.
INDEXNOW_KEY=
